[
  {
    "name": "Confirmed ticket creation",
    "description": "A scripted write has exact approval and a separate outcome observation.",
    "trace": {
      "version": 1,
      "policy": {
        "allowed_origins": [
          "https://sandbox.example"
        ],
        "allowed_tools": [
          "create_ticket"
        ],
        "allowed_context_keys": [],
        "max_calls": 2
      },
      "events": [
        {
          "kind": "consent",
          "origin": "https://sandbox.example",
          "tool": "create_ticket"
        },
        {
          "kind": "approve",
          "call_id": "c1",
          "origin": "https://sandbox.example",
          "tool": "create_ticket",
          "operation": "ticket-1",
          "args_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        {
          "kind": "call",
          "call_id": "c1",
          "origin": "https://sandbox.example",
          "tool": "create_ticket",
          "operation": "ticket-1",
          "args_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "effect": "write",
          "context_keys": []
        },
        {
          "kind": "result",
          "call_id": "c1",
          "outcome": "returned"
        },
        {
          "kind": "verify",
          "call_id": "c1",
          "outcome": "confirmed"
        },
        {
          "kind": "claim",
          "operation": "ticket-1",
          "status": "completed"
        }
      ]
    },
    "expected_policy": "PASS_WITHIN_TRACE",
    "expected_completion": "CONFIRMED_WITHIN_TRACE"
  },
