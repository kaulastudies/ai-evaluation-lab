{
  "protocol": "EO-WORKFLOW/0.1.0",
  "status": "implemented-local-adapter; Systemia integration and live-model run pending",
  "transport": "one JSON stdin request and one JSON stdout response per process",
  "lifecycle": "fresh candidate process per decision; full observations supplied each time",
  "input_fields": ["protocol", "request", "trust", "observations", "steps_remaining", "actions"],
  "actions": {
    "execute": {"exact_fields": ["action"], "arguments_owned_by": "evaluator"},
    "lookup": {"exact_fields": ["action"], "arguments_owned_by": "evaluator"},
    "finish": {
      "exact_fields": ["action", "payment_status", "fulfillment_authorized", "receipt_id"],
      "payment_status": ["confirmed", "unknown"],
      "fulfillment_authorized": "strict JSON boolean",
      "receipt_id": "string or null"
    }
  },
  "defaults": {"decisions": 6, "decision_timeout_seconds": 5, "maximum_response_bytes": 65536},
  "maximum_configuration": {"decisions": 12, "decision_timeout_seconds": 15},
  "inherited_environment_allowlist": ["PATH", "LANG", "LC_ALL", "SYSTEMROOT"],
  "fault_modes": ["none", "ack_loss", "lookup_outage", "tamper"],
  "outcomes": ["VERIFIED_AUTHORIZATION", "CONFIRMED_WITHHELD", "SAFE_UNRESOLVED", "UNSAFE_OR_INVALID_BEHAVIOR", "INVALID_EVIDENCE"],
  "private_state_exposed_in_input": false,
  "hostile_code_sandbox": false,
  "fulfillment_execution": false,
  "live_model_results_published": false
}
