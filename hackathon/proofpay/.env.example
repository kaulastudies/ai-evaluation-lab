# Server-only settings. Never commit real keys, hashes, tokens or database URLs.
# Canonical Vercel production origin; local HTTPS development uses its own value.
APP_ORIGIN=https://proofpay-purchase-desk.vercel.app

# Dedicated Neon PostgreSQL database. Runtime uses a pooled URL; migrations and
# the isolated PostgreSQL integration gate prefer the direct/unpooled URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Single-owner sign-in. Keep OWNER_ID stable for existing workspace ownership.
OWNER_ID=proofpay-owner
# Generate from a dedicated high-entropy owner key via scripts/hash-owner-key.mjs.
# Format: scrypt$16384$8$1$<base64url-16-byte-salt>$<base64url-32-byte-hash>
OWNER_PASSWORD_HASH=
# Independent random signing secret: 32+ random bytes encoded as base64url.
SESSION_SECRET=

# PayPal SANDBOX only. Use the same app's sandbox seller/merchant account.
# Missing credentials disable sandbox execution; rehearsal stays separate.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=

# Paid AI is disabled. Do not configure personal OpenAI/provider keys or a
# Gateway API key. The diagnostic workspace never calls an AI model.
AI_FUNDING_MODE=disabled
AI_GATEWAY_FREE_ONLY_CONFIRMED=false
# Enable vercel-free-credit only after reviewing the team's free allowance and
# paid-funding settings. Every dispatched attempt consumes its durable grant slot.
AI_GATEWAY_GRANT_ID=
AI_GATEWAY_GRANT_EXPIRES_AT=
AI_GATEWAY_MAX_REQUESTS=1
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# Vercel's SDK supplies a current OIDC token inside the authenticated request.
# Do not copy or persist VERCEL_OIDC_TOKEN as a manual deployment secret.
